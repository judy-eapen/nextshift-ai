flowchart TB
  subgraph UI["Streamlit · NextShift AI"]
    direction LR
    START["Start<br/>I'm exploring careers · I'm preparing for change"]
    INTAKE["Guided intake<br/>role · week · industry · concerns · horizon<br/>(student: interests · strengths · careers · constraints)"]
    PLAN["Your plan<br/>1 outlook · 2 how the work changes · 3 for you<br/>4 30d / 6m / 1y · 5 other paths · 6 confidence<br/>7 ▸ how we reached this answer"]
  end

  subgraph GRAPH["LangGraph supervisor · SQLite checkpointer · LangSmith tracing"]
    RES["Occupation resolver (pre-graph)<br/>exact title → semantic → composite from 18K task statements"]
    UND["understand · PLANNER<br/>restate the person in plain words"]
    HITL1{{"⏸ Understanding gate<br/>confirm / edit / reject · zero tool spend before this"}}
    subgraph GATHER["Evidence gatherers · Send fan-out per occupation"]
      direction LR
      GO["outlook<br/>BLS projections 2025–35"]
      GE["exposure<br/>O*NET tasks × AEI · AIOE"]
      GF["forecasts<br/>+ relevance filter"]
      GR["research<br/>Epoch · FRED"]
    end
    REC["reconcile (code)<br/>dedupe · refs · disagreements · unknowns · deltas vs snapshot"]
    OUT["write_outlook<br/>demand from BLS only · AI change = labelled interpretation<br/>3 task groups: assists · more important · uncertain"]
    WP["write_plan · PLANNER<br/>direct answer · for you · 30/6/12 · comparison (students) · confidence"]
    SKEP["skeptic · different model family<br/>line-by-line: facts need cards · interpretation tagged · advice labelled"]
    HITL2{{"⏸ Plan gate<br/>approve / edit / reject"}}
    RECD["record · the only writer<br/>plan file · evidence snapshot · profile"]
  end

  subgraph SRC["Read-only tools · errors are data"]
    direction TB
    BLS["BLS OES + Employment Projections"]
    ONET["O*NET tasks · Web Services"]
    AEI["Anthropic Economic Index"]
    AIOE["AIOE"]
    MKT["Polymarket · Manifold · Metaculus"]
    EPOCH["Epoch AI · FRED"]
  end

  MEM[("SQLite memory<br/>snapshots per approved run · profile")]

  START --> INTAKE --> RES --> UND --> HITL1
  HITL1 -- confirm / edit --> GATHER
  HITL1 -- reject --> END1((end · nothing written))
  GATHER --> REC --> OUT --> WP --> SKEP
  SKEP -- ">30% unsupported, once" --> WP
  SKEP --> PLAN --> HITL2
  HITL2 -- approve / edit --> RECD --> MEM
  HITL2 -- reject --> END2((end · nothing written))
  MEM -. "next run: since your last plan" .-> REC
  GATHER -- "read-only tool calls · retry ×2 · unavailable = badge, not a crash" --> SRC

  classDef human fill:#E5A24A,stroke:#8a5a10,color:#111
  classDef write fill:#8FBF9F,stroke:#3d6b4b,color:#111
  class HITL1,HITL2 human
  class RECD write
